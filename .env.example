# Copiez ce fichier en `.env` à la racine du projet. Ne le committez jamais.

# Doublr fonctionne GRATUITEMENT sans aucune clé : traduction locale (Ollama) et voix locales (Kokoro, Piper).
# Les clés ci-dessous sont facultatives et donnent accès aux moteurs premium.

# --- Clés API (facultatives) ---
ANTHROPIC_API_KEY=            # traduction premium (Claude, payant)
AZURE_SPEECH_KEY=             # 400+ voix premium Azure (gratuit jusqu'à 500 000 caractères/mois)
AZURE_SPEECH_REGION=westeurope
ELEVENLABS_API_KEY=           # optionnel : second fournisseur TTS
HF_TOKEN=                     # optionnel : diarisation pyannote (multi-locuteurs)

# --- Réglages ---
DOUBLR_TRANSLATOR=auto        # auto (Claude si clé, sinon local) | local | claude
DOUBLR_LOCAL_LLM=gemma3:4b    # modèle Ollama : gemma3:4b | gemma3:12b | qwen2.5:7b
OLLAMA_HOST=http://127.0.0.1:11434
DOUBLR_TTS_PROVIDER=auto      # voix par défaut : auto | kokoro | piper | azure | elevenlabs
DOUBLR_CLAUDE_MODEL=claude-opus-5
DOUBLR_CLAUDE_EFFORT=medium   # low | medium | high
DOUBLR_WHISPER_MODEL=large-v3 # large-v3 | medium
DOUBLR_DEVICE=auto            # auto | cpu | cuda | mps
DOUBLR_TTS_CONCURRENCY=4
DOUBLR_FILE_CONCURRENCY=2
# true = seules les voix validées humainement (validated_by/validated_on) sont proposées
DOUBLR_REQUIRE_VALIDATED_VOICES=false
# Origines autorisées à appeler le serveur local (ajoutez l'URL de votre GitHub Pages si vous forkez)
DOUBLR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://coachccai-blip.github.io
# DOUBLR_DATA_DIR=./data
# DOUBLR_OUTPUT_DIR=./exports
